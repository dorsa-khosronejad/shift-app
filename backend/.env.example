# Copy this file to .env and fill in real values before running.
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

PORT=4000

# Used to sign short-lived access tokens (15 min)
JWT_ACCESS_SECRET=replace_with_a_long_random_string

# Used to sign longer-lived refresh tokens (7 days)
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# Set to "production" when deployed behind HTTPS (enables secure cookies)
NODE_ENV=development

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5500

# Required for emailed password reset links
FRONTEND_URL=http://localhost:5500
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=Shift & Care <no-reply@example.com>

# How many days of backups to keep (scripts/backup.js prunes older ones)
BACKUP_RETENTION_DAYS=30
